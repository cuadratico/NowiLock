<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".RegisterActivity"
    android:background="@color/grew_o_2">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/back_all_bio_error"
        android:layout_width="200dp"
        android:layout_height="200dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/bio_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/biometric_error"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/info_bio_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/information"
            app:layout_constraintStart_toEndOf="@id/bio_error"
            app:layout_constraintBottom_toTopOf="@id/bio_error"
            android:layout_marginBottom="5dp"
            android:layout_marginStart="5dp"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/back_all"
        android:layout_width="320dp"
        android:layout_height="300dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        >

        <TextView
            android:id="@+id/info"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:text="Make sure no one is watching your screen"
            android:fontFamily="monospace"
            app:layout_constraintBottom_toTopOf="@id/all"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_margin="50dp"
            android:textSize="15dp"
            android:gravity="center"
            android:textColor="@color/white"
            />

        <TextView
            android:id="@+id/opor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="**********"
            android:textSize="20dp"
            android:textColor="@color/blue_nowi"
            android:fontFamily="monospace"
            app:layout_constraintEnd_toEndOf="@id/all"
            app:layout_constraintStart_toStartOf="@id/all"
            app:layout_constraintBottom_toTopOf="@id/all"
            app:layout_constraintTop_toBottomOf="@id/info"
            />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/all"
            android:layout_width="300dp"
            android:layout_height="70dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:boxStrokeColor="@color/style_blue_white"
            app:passwordToggleEnabled="true"
            >

            <EditText
                android:id="@+id/input_pass"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:hint="Pass..."
                android:textSize="17dp"
                android:textColor="@color/white"
                android:gravity="center"
                android:maxLines="1"
                android:inputType="textPassword"
                />


        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="@id/all"
            app:layout_constraintStart_toStartOf="@id/all"
            app:layout_constraintTop_toBottomOf="@id/all"
            app:indicatorColor="@color/grew_o_2"
            app:trackColor="@color/grew_o_2"
            />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/bottom_create"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/fingerprint"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/all"
            android:layout_marginTop="40dp"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>